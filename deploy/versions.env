# Single source of truth for what goes into the production image. Read by
# deploy/build.sh, deploy/run_production.sh and .github/workflows/ci.yml.
#
# bench clones apps with `git clone --branch`, which takes a branch or a tag but
# not a commit, so every app is pinned to a release tag in deploy/apps.json
# (payments has no releases and stays on its branch). Bump a pin deliberately,
# let CI run the tests against it, then release.
FRAPPE_BRANCH=v16.54.0
PYTHON_VERSION=3.14.10
NODE_VERSION=24.22.2
# frappe_docker commit whose images/custom/Containerfile builds the image
FRAPPE_DOCKER_REF=61d35da827ebc04d01b64c9e78385597ccebc9d8
